# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-32-bytes

# Database Configuration
DATABASE_PATH=instance/smart_queue.sqlite

# Queue Application Settings
SERVICE_CENTRE_NAME=Civic & Healthcare Service Hub
ACTIVE_COUNTERS=2
APPROACHING_THRESHOLD=2
FALLBACK_SERVICE_DURATION_MINUTES=5

# Email & Notification Settings
APP_DEMO_MODE=True
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=your-secure-mail-password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER="Smart Queue System <notifications@example.com>"
